<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="p01_Definiciones" targetNamespace="http://gestion-eventos.local/bpmn/p01">
  <bpmn:collaboration id="p01_Colaboracion" name="Registro y autenticación">
    <bpmn:participant id="p01_Pool_Sistema" name="Sistema de gestión de eventos" processRef="p01_Proc_Registro"/>
  </bpmn:collaboration>
  <bpmn:process id="p01_Proc_Registro" name="Registro y autenticación" isExecutable="false" processType="None">
    <bpmn:laneSet id="p01_LaneSet_Proc_Registro">
      <bpmn:lane id="p01_Lane_Usuario" name="Usuario (Asistente / Organizador)">
        <bpmn:flowNodeRef>p01_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_Gw_TieneCuenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_Formulario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_ConfirmarCorreo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_Gw_UnirAcceso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_Credenciales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_Panel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_Fin_Autenticado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p01_Lane_Plataforma" name="Plataforma (sistema)">
        <bpmn:flowNodeRef>p01_T_ValidarDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_Gw_DatosValidos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_CrearCuenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_EnviarCorreo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_ActivarCuenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_Autenticar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_Gw_CredValidas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_Token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_IntentoFallido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_Gw_Intentos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_Bloquear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_T_NotificarBloqueo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p01_Fin_Bloqueada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p01_Inicio" name="Usuario accede a la plataforma">
      <bpmn:outgoing>p01_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="p01_Gw_TieneCuenta" name="¿Tiene cuenta registrada?" gatewayDirection="Diverging">
      <bpmn:incoming>p01_F01</bpmn:incoming>
      <bpmn:outgoing>p01_F02</bpmn:outgoing>
      <bpmn:outgoing>p01_F03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p01_T_Formulario" name="Completar formulario de registro">
      <bpmn:incoming>p01_F02</bpmn:incoming>
      <bpmn:incoming>p01_F07</bpmn:incoming>
      <bpmn:outgoing>p01_F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p01_T_ValidarDatos" name="Validar datos de registro">
      <bpmn:documentation>ms-usuarios: valida formato, unicidad del correo y política de contraseña.</bpmn:documentation>
      <bpmn:incoming>p01_F04</bpmn:incoming>
      <bpmn:outgoing>p01_F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p01_Gw_DatosValidos" name="¿Datos válidos?" gatewayDirection="Diverging">
      <bpmn:incoming>p01_F05</bpmn:incoming>
      <bpmn:outgoing>p01_F06</bpmn:outgoing>
      <bpmn:outgoing>p01_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p01_T_CrearCuenta" name="Crear cuenta de usuario">
      <bpmn:documentation>ms-usuarios: crea la cuenta en estado pendiente y asigna el rol (asistente u organizador).</bpmn:documentation>
      <bpmn:incoming>p01_F06</bpmn:incoming>
      <bpmn:outgoing>p01_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p01_T_EnviarCorreo" name="Enviar correo de verificación">
      <bpmn:documentation>ms-notificaciones: envía el enlace de verificación.</bpmn:documentation>
      <bpmn:incoming>p01_F08</bpmn:incoming>
      <bpmn:outgoing>p01_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="p01_T_ConfirmarCorreo" name="Confirmar correo electrónico">
      <bpmn:incoming>p01_F09</bpmn:incoming>
      <bpmn:outgoing>p01_F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p01_T_ActivarCuenta" name="Activar cuenta">
      <bpmn:incoming>p01_F10</bpmn:incoming>
      <bpmn:outgoing>p01_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p01_Gw_UnirAcceso" gatewayDirection="Converging">
      <bpmn:incoming>p01_F03</bpmn:incoming>
      <bpmn:incoming>p01_F11</bpmn:incoming>
      <bpmn:outgoing>p01_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p01_T_Credenciales" name="Ingresar credenciales">
      <bpmn:incoming>p01_F12</bpmn:incoming>
      <bpmn:incoming>p01_F21</bpmn:incoming>
      <bpmn:outgoing>p01_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p01_T_Autenticar" name="Autenticar credenciales">
      <bpmn:documentation>ms-autenticacion: verifica el hash de la contraseña.</bpmn:documentation>
      <bpmn:incoming>p01_F13</bpmn:incoming>
      <bpmn:outgoing>p01_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p01_Gw_CredValidas" name="¿Credenciales válidas?" gatewayDirection="Diverging">
      <bpmn:incoming>p01_F14</bpmn:incoming>
      <bpmn:outgoing>p01_F15</bpmn:outgoing>
      <bpmn:outgoing>p01_F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p01_T_Token" name="Generar token de sesión (JWT)">
      <bpmn:documentation>ms-autenticacion: emite JWT de acceso y token de refresco.</bpmn:documentation>
      <bpmn:incoming>p01_F15</bpmn:incoming>
      <bpmn:outgoing>p01_F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="p01_T_Panel" name="Acceder al panel principal">
      <bpmn:incoming>p01_F17</bpmn:incoming>
      <bpmn:outgoing>p01_F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p01_Fin_Autenticado" name="Usuario autenticado">
      <bpmn:incoming>p01_F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="p01_T_IntentoFallido" name="Registrar intento fallido">
      <bpmn:incoming>p01_F16</bpmn:incoming>
      <bpmn:outgoing>p01_F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p01_Gw_Intentos" name="¿Superó 3 intentos fallidos?" gatewayDirection="Diverging">
      <bpmn:incoming>p01_F19</bpmn:incoming>
      <bpmn:outgoing>p01_F20</bpmn:outgoing>
      <bpmn:outgoing>p01_F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p01_T_Bloquear" name="Bloquear cuenta temporalmente">
      <bpmn:incoming>p01_F20</bpmn:incoming>
      <bpmn:outgoing>p01_F22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p01_T_NotificarBloqueo" name="Notificar bloqueo al usuario">
      <bpmn:documentation>ms-notificaciones</bpmn:documentation>
      <bpmn:incoming>p01_F22</bpmn:incoming>
      <bpmn:outgoing>p01_F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p01_Fin_Bloqueada" name="Cuenta bloqueada">
      <bpmn:incoming>p01_F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p01_F01" sourceRef="p01_Inicio" targetRef="p01_Gw_TieneCuenta"/>
    <bpmn:sequenceFlow id="p01_F02" name="No" sourceRef="p01_Gw_TieneCuenta" targetRef="p01_T_Formulario"/>
    <bpmn:sequenceFlow id="p01_F03" name="Sí" sourceRef="p01_Gw_TieneCuenta" targetRef="p01_Gw_UnirAcceso"/>
    <bpmn:sequenceFlow id="p01_F04" sourceRef="p01_T_Formulario" targetRef="p01_T_ValidarDatos"/>
    <bpmn:sequenceFlow id="p01_F05" sourceRef="p01_T_ValidarDatos" targetRef="p01_Gw_DatosValidos"/>
    <bpmn:sequenceFlow id="p01_F06" name="Sí" sourceRef="p01_Gw_DatosValidos" targetRef="p01_T_CrearCuenta"/>
    <bpmn:sequenceFlow id="p01_F07" name="No" sourceRef="p01_Gw_DatosValidos" targetRef="p01_T_Formulario"/>
    <bpmn:sequenceFlow id="p01_F08" sourceRef="p01_T_CrearCuenta" targetRef="p01_T_EnviarCorreo"/>
    <bpmn:sequenceFlow id="p01_F09" sourceRef="p01_T_EnviarCorreo" targetRef="p01_T_ConfirmarCorreo"/>
    <bpmn:sequenceFlow id="p01_F10" sourceRef="p01_T_ConfirmarCorreo" targetRef="p01_T_ActivarCuenta"/>
    <bpmn:sequenceFlow id="p01_F11" sourceRef="p01_T_ActivarCuenta" targetRef="p01_Gw_UnirAcceso"/>
    <bpmn:sequenceFlow id="p01_F12" sourceRef="p01_Gw_UnirAcceso" targetRef="p01_T_Credenciales"/>
    <bpmn:sequenceFlow id="p01_F13" sourceRef="p01_T_Credenciales" targetRef="p01_T_Autenticar"/>
    <bpmn:sequenceFlow id="p01_F14" sourceRef="p01_T_Autenticar" targetRef="p01_Gw_CredValidas"/>
    <bpmn:sequenceFlow id="p01_F15" name="Sí" sourceRef="p01_Gw_CredValidas" targetRef="p01_T_Token"/>
    <bpmn:sequenceFlow id="p01_F16" name="No" sourceRef="p01_Gw_CredValidas" targetRef="p01_T_IntentoFallido"/>
    <bpmn:sequenceFlow id="p01_F17" sourceRef="p01_T_Token" targetRef="p01_T_Panel"/>
    <bpmn:sequenceFlow id="p01_F18" sourceRef="p01_T_Panel" targetRef="p01_Fin_Autenticado"/>
    <bpmn:sequenceFlow id="p01_F19" sourceRef="p01_T_IntentoFallido" targetRef="p01_Gw_Intentos"/>
    <bpmn:sequenceFlow id="p01_F20" name="Sí" sourceRef="p01_Gw_Intentos" targetRef="p01_T_Bloquear"/>
    <bpmn:sequenceFlow id="p01_F21" name="No" sourceRef="p01_Gw_Intentos" targetRef="p01_T_Credenciales"/>
    <bpmn:sequenceFlow id="p01_F22" sourceRef="p01_T_Bloquear" targetRef="p01_T_NotificarBloqueo"/>
    <bpmn:sequenceFlow id="p01_F23" sourceRef="p01_T_NotificarBloqueo" targetRef="p01_Fin_Bloqueada"/>
    <bpmn:textAnnotation id="p01_Nota_Roles">
      <bpmn:text>Asistentes y organizadores siguen el mismo flujo; el rol se elige al registrarse.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="p01_Asoc_Nota_Roles" associationDirection="None" sourceRef="p01_Nota_Roles" targetRef="p01_Inicio"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p01_Diagrama" name="Registro y autenticación">
    <bpmndi:BPMNPlane id="p01_Plano" bpmnElement="p01_Colaboracion">
      <bpmndi:BPMNShape id="p01_Pool_Sistema_di" bpmnElement="p01_Pool_Sistema" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="3116" height="640"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p01_Lane_Usuario_di" bpmnElement="p01_Lane_Usuario" isHorizontal="true">

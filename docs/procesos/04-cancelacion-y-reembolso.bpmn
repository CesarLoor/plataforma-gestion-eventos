<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="p04_Definiciones" targetNamespace="http://gestion-eventos.local/bpmn/p04">
  <bpmn:message id="p04_Msg_Reembolso" name="Solicitud de reembolso"/>
  <bpmn:message id="p04_Msg_Confirmacion" name="Confirmación de reembolso"/>
  <bpmn:collaboration id="p04_Colaboracion" name="Cancelación y reembolso">
    <bpmn:participant id="p04_Pool_Sistema" name="Sistema de gestión de eventos" processRef="p04_Proc_Cancelacion"/>
    <bpmn:participant id="p04_Pool_Pasarela" name="Pasarela de pago (externa)" processRef="p04_Proc_Reembolso"/>
    <bpmn:messageFlow id="p04_MF_Reembolso" name="Solicitud de reembolso" sourceRef="p04_T_SolicitarReembolso" targetRef="p04_PG_Inicio" messageRef="p04_Msg_Reembolso"/>
    <bpmn:messageFlow id="p04_MF_Confirmacion" name="Confirmación de reembolso" sourceRef="p04_PG_Fin" targetRef="p04_Ev_Confirmacion" messageRef="p04_Msg_Confirmacion"/>
  </bpmn:collaboration>
  <bpmn:process id="p04_Proc_Cancelacion" name="Cancelación y reembolso" isExecutable="false" processType="None">
    <bpmn:laneSet id="p04_LaneSet_Proc_Cancelacion">
      <bpmn:lane id="p04_Lane_Asistente" name="Asistente">
        <bpmn:flowNodeRef>p04_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_T_Seleccionar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p04_Lane_Organizador" name="Organizador">
        <bpmn:flowNodeRef>p04_T_Revisar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p04_Lane_Plataforma" name="Plataforma (sistema)">
        <bpmn:flowNodeRef>p04_T_Politica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_Gw_Politica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_T_Monto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_T_Rechazo1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_Fin_Rechazada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_Gw_Aprobacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_T_AutoAprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_Gw_UnirDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_Gw_Aprobado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_T_Anular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_T_Rechazo2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_Fin_ReembolsoRechazado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_T_SolicitarReembolso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_Ev_Confirmacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_T_Notificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p04_Fin_Reembolsado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p04_Inicio" name="Asistente solicita cancelar su entrada">
      <bpmn:outgoing>p04_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p04_T_Seleccionar" name="Seleccionar ticket y motivo de cancelación">
      <bpmn:incoming>p04_F01</bpmn:incoming>
      <bpmn:outgoing>p04_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p04_T_Politica" name="Verificar política de cancelación">
      <bpmn:documentation>ms-reservas: plazo de cancelación, estado del ticket y del evento.</bpmn:documentation>
      <bpmn:incoming>p04_F02</bpmn:incoming>
      <bpmn:outgoing>p04_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p04_Gw_Politica" name="¿Cumple la política de cancelación?" gatewayDirection="Diverging">
      <bpmn:incoming>p04_F03</bpmn:incoming>
      <bpmn:outgoing>p04_F04</bpmn:outgoing>
      <bpmn:outgoing>p04_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p04_T_Monto" name="Calcular monto a reembolsar">
      <bpmn:documentation>ms-pagos</bpmn:documentation>
      <bpmn:incoming>p04_F04</bpmn:incoming>
      <bpmn:outgoing>p04_F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p04_T_Rechazo1" name="Notificar rechazo de la cancelación">
      <bpmn:incoming>p04_F05</bpmn:incoming>
      <bpmn:outgoing>p04_F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p04_Fin_Rechazada" name="Cancelación rechazada">
      <bpmn:incoming>p04_F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="p04_Gw_Aprobacion" name="¿Requiere aprobación del organizador?" gatewayDirection="Diverging">
      <bpmn:incoming>p04_F07</bpmn:incoming>
      <bpmn:outgoing>p04_F08</bpmn:outgoing>
      <bpmn:outgoing>p04_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p04_T_Revisar" name="Revisar solicitud de reembolso">
      <bpmn:incoming>p04_F08</bpmn:incoming>
      <bpmn:outgoing>p04_F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p04_T_AutoAprobar" name="Aprobar reembolso automáticamente">
      <bpmn:incoming>p04_F09</bpmn:incoming>
      <bpmn:outgoing>p04_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p04_Gw_UnirDecision" gatewayDirection="Converging">
      <bpmn:incoming>p04_F10</bpmn:incoming>
      <bpmn:incoming>p04_F11</bpmn:incoming>
      <bpmn:outgoing>p04_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p04_Gw_Aprobado" name="¿Reembolso aprobado?" gatewayDirection="Diverging">
      <bpmn:incoming>p04_F12</bpmn:incoming>
      <bpmn:outgoing>p04_F13</bpmn:outgoing>
      <bpmn:outgoing>p04_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p04_T_Anular" name="Anular ticket y liberar cupo">
      <bpmn:documentation>ms-tickets (anula) y ms-reservas (devuelve el cupo al inventario).</bpmn:documentation>
      <bpmn:incoming>p04_F13</bpmn:incoming>
      <bpmn:outgoing>p04_F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p04_T_Rechazo2" name="Notificar rechazo del reembolso">
      <bpmn:incoming>p04_F14</bpmn:incoming>
      <bpmn:outgoing>p04_F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p04_Fin_ReembolsoRechazado" name="Reembolso rechazado">
      <bpmn:incoming>p04_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="p04_T_SolicitarReembolso" name="Solicitar reembolso a la pasarela">
      <bpmn:documentation>ms-pagos</bpmn:documentation>
      <bpmn:incoming>p04_F16</bpmn:incoming>
      <bpmn:outgoing>p04_F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="p04_Ev_Confirmacion" name="Confirmación de reembolso recibida">
      <bpmn:incoming>p04_F17</bpmn:incoming>
      <bpmn:outgoing>p04_F18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="p04_Def_Ev_Confirmacion" messageRef="p04_Msg_Confirmacion"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="p04_T_Notificar" name="Notificar reembolso al asistente">
      <bpmn:documentation>ms-notificaciones</bpmn:documentation>
      <bpmn:incoming>p04_F18</bpmn:incoming>
      <bpmn:outgoing>p04_F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p04_Fin_Reembolsado" name="Reembolso completado">
      <bpmn:incoming>p04_F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p04_F01" sourceRef="p04_Inicio" targetRef="p04_T_Seleccionar"/>
    <bpmn:sequenceFlow id="p04_F02" sourceRef="p04_T_Seleccionar" targetRef="p04_T_Politica"/>
    <bpmn:sequenceFlow id="p04_F03" sourceRef="p04_T_Politica" targetRef="p04_Gw_Politica"/>
    <bpmn:sequenceFlow id="p04_F04" name="Sí" sourceRef="p04_Gw_Politica" targetRef="p04_T_Monto"/>
    <bpmn:sequenceFlow id="p04_F05" name="No" sourceRef="p04_Gw_Politica" targetRef="p04_T_Rechazo1"/>
    <bpmn:sequenceFlow id="p04_F06" sourceRef="p04_T_Rechazo1" targetRef="p04_Fin_Rechazada"/>
    <bpmn:sequenceFlow id="p04_F07" sourceRef="p04_T_Monto" targetRef="p04_Gw_Aprobacion"/>
    <bpmn:sequenceFlow id="p04_F08" name="Sí (&lt; 48 h)" sourceRef="p04_Gw_Aprobacion" targetRef="p04_T_Revisar"/>
    <bpmn:sequenceFlow id="p04_F09" name="No" sourceRef="p04_Gw_Aprobacion" targetRef="p04_T_AutoAprobar"/>
    <bpmn:sequenceFlow id="p04_F10" sourceRef="p04_T_Revisar" targetRef="p04_Gw_UnirDecision"/>
    <bpmn:sequenceFlow id="p04_F11" sourceRef="p04_T_AutoAprobar" targetRef="p04_Gw_UnirDecision"/>
    <bpmn:sequenceFlow id="p04_F12" sourceRef="p04_Gw_UnirDecision" targetRef="p04_Gw_Aprobado"/>
    <bpmn:sequenceFlow id="p04_F13" name="Sí" sourceRef="p04_Gw_Aprobado" targetRef="p04_T_Anular"/>
    <bpmn:sequenceFlow id="p04_F14" name="No" sourceRef="p04_Gw_Aprobado" targetRef="p04_T_Rechazo2"/>
    <bpmn:sequenceFlow id="p04_F15" sourceRef="p04_T_Rechazo2" targetRef="p04_Fin_ReembolsoRechazado"/>
    <bpmn:sequenceFlow id="p04_F16" sourceRef="p04_T_Anular" targetRef="p04_T_SolicitarReembolso"/>
    <bpmn:sequenceFlow id="p04_F17" sourceRef="p04_T_SolicitarReembolso" targetRef="p04_Ev_Confirmacion"/>
    <bpmn:sequenceFlow id="p04_F18" sourceRef="p04_Ev_Confirmacion" targetRef="p04_T_Notificar"/>
    <bpmn:sequenceFlow id="p04_F19" sourceRef="p04_T_Notificar" targetRef="p04_Fin_Reembolsado"/>
    <bpmn:textAnnotation id="p04_Nota_48h">
      <bpmn:text>Revisión manual: aplica cuando faltan menos de 48 h para el evento.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="p04_Asoc_Nota_48h" associationDirection="None" sourceRef="p04_Nota_48h" targetRef="p04_T_Revisar"/>
  </bpmn:process>
  <bpmn:process id="p04_Proc_Reembolso" name="Procesamiento del reembolso" isExecutable="false" processType="None">
    <bpmn:startEvent id="p04_PG_Inicio" name="Solicitud de reembolso recibida">
      <bpmn:outgoing>p04_PF1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="p04_Def_PG_Inicio" messageRef="p04_Msg_Reembolso"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="p04_PG_Procesar" name="Procesar reembolso al medio de pago">
      <bpmn:incoming>p04_PF1</bpmn:incoming>
      <bpmn:outgoing>p04_PF2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p04_PG_Fin" name="Confirmación de reembolso enviada">
      <bpmn:incoming>p04_PF2</bpmn:incoming>
      <bpmn:messageEventDefinition id="p04_Def_PG_Fin" messageRef="p04_Msg_Confirmacion"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p04_PF1" sourceRef="p04_PG_Inicio" targetRef="p04_PG_Procesar"/>
    <bpmn:sequenceFlow id="p04_PF2" sourceRef="p04_PG_Procesar" targetRef="p04_PG_Fin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p04_Diagrama" name="Cancelación y reembolso">
    <bpmndi:BPMNPlane id="p04_Plano" bpmnElement="p04_Colaboracion">
      <bpmndi:BPMNShape id="p04_Pool_Sistema_di" bpmnElement="p04_Pool_Sistema" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="2454" height="790"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p04_Lane_Asistente_di" bpmnElement="p04_Lane_Asistente" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="2424" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p04_Lane_Organizador_di" bpmnElement="p04_Lane_Organizador" isHorizontal="true">
        <dc:Bounds x="70" y="200" width="2424" height="310"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p04_Lane_Plataforma_di" bpmnElement="p04_Lane_Plataforma" isHorizontal="true">
        <dc:Bounds x="70" y="510" width="2424" height="320"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p04_Pool_Pasarela_di" bpmnElement="p04_Pool_Pasarela" isHorizontal="true">
        <dc:Bounds x="40" y="900" width="2454" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p04_Inicio_di" bpmnElement="p04_Inicio">
        <dc:Bounds x="150" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="127" y="144" width="82" height="56"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

        <dc:Bounds x="918" y="732" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="895" y="774" width="82" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p04_Gw_Aprobacion_di" bpmnElement="p04_Gw_Aprobacion">
        <dc:Bounds x="916" y="570" width="40" height="40"/>
        <bpmndi:BPMNLabel><dc:Bounds x="893" y="616" width="86" height="42"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="p04_F01_di" bpmnElement="p04_F01">
        <di:waypoint x="186" y="120"/>
        <di:waypoint x="246" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p04_F02_di" bpmnElement="p04_F02">
        <di:waypoint x="376" y="120"/>
        <di:waypoint x="406" y="120"/>
        <di:waypoint x="406" y="590"/>
        <di:waypoint x="436" y="590"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p04_F03_di" bpmnElement="p04_F03">
        <di:waypoint x="566" y="590"/>
        <di:waypoint x="626" y="590"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p04_F04_di" bpmnElement="p04_F04">
        <di:waypoint x="666" y="590"/>
        <di:waypoint x="726" y="590"/>
        <bpmndi:BPMNLabel><dc:Bounds x="672" y="572" width="24" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p04_F05_di" bpmnElement="p04_F05">
        <di:waypoint x="646" y="610"/>
        <di:waypoint x="646" y="750"/>
        <di:waypoint x="726" y="750"/>
        <bpmndi:BPMNLabel><dc:Bounds x="652" y="614" width="24" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p04_F06_di" bpmnElement="p04_F06">
        <di:waypoint x="856" y="750"/>
        <di:waypoint x="918" y="750"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p04_F07_di" bpmnElement="p04_F07">
        <di:waypoint x="856" y="590"/>
        <di:waypoint x="916" y="590"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p04_F08_di" bpmnElement="p04_F08">
        <di:waypoint x="936" y="570"/>
        <di:waypoint x="936" y="280"/>
        <di:waypoint x="1036" y="280"/>
        <bpmndi:BPMNLabel><dc:Bounds x="942" y="552" width="72" height="14"/></bpmndi:BPMNLabel>

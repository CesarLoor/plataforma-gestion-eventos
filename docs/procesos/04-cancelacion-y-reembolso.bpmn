      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p04_Gw_UnirDecision_di" bpmnElement="p04_Gw_UnirDecision">
        <dc:Bounds x="1246" y="570" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p04_Gw_Aprobado_di" bpmnElement="p04_Gw_Aprobado">

        <di:waypoint x="1331" y="760"/>
        <di:waypoint x="1501" y="760"/>
        <di:waypoint x="1501" y="475"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p05_F12_di" bpmnElement="p05_F12">
        <di:waypoint x="1166" y="600"/>
        <di:waypoint x="1216" y="600"/>
        <di:waypoint x="1216" y="280"/>
        <di:waypoint x="1246" y="280"/>
      </bpmndi:BPMNEdge>

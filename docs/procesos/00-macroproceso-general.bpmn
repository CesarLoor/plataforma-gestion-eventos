<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="p00_Definiciones" targetNamespace="http://gestion-eventos.local/bpmn/p00">
  <bpmn:message id="p00_Msg_Cobro" name="Solicitud de cobro"/>
  <bpmn:message id="p00_Msg_Resultado" name="Resultado del pago"/>
  <bpmn:message id="p00_Msg_Reembolso" name="Solicitud de reembolso"/>
  <bpmn:message id="p00_Msg_Confirmacion" name="Confirmación de reembolso"/>
  <bpmn:collaboration id="p00_Colaboracion" name="Macroproceso de gestión de eventos">
    <bpmn:participant id="p00_Pool_Pasarela" name="Pasarela de pago (externa)" processRef="p00_Proc_Pasarela"/>
    <bpmn:participant id="p00_Pool_Sistema" name="Sistema de gestión de eventos" processRef="p00_Proc_Macro"/>
    <bpmn:messageFlow id="p00_MF_Cobro" name="Solicitud de cobro" sourceRef="p00_SP_Compra" targetRef="p00_Pool_Pasarela" messageRef="p00_Msg_Cobro"/>
    <bpmn:messageFlow id="p00_MF_Resultado" name="Resultado del pago" sourceRef="p00_Pool_Pasarela" targetRef="p00_SP_Compra" messageRef="p00_Msg_Resultado"/>
    <bpmn:messageFlow id="p00_MF_Reembolso" name="Solicitud de reembolso" sourceRef="p00_SP_Cancelar" targetRef="p00_Pool_Pasarela" messageRef="p00_Msg_Reembolso"/>
    <bpmn:messageFlow id="p00_MF_Confirmacion" name="Confirmación de reembolso" sourceRef="p00_Pool_Pasarela" targetRef="p00_SP_Cancelar" messageRef="p00_Msg_Confirmacion"/>
  </bpmn:collaboration>
  <bpmn:process id="p00_Proc_Pasarela" name="Pasarela de pago (caja negra)" isExecutable="false" processType="None">
  </bpmn:process>
  <bpmn:process id="p00_Proc_Macro" name="Macroproceso de gestión de eventos" isExecutable="false" processType="None">
    <bpmn:laneSet id="p00_LaneSet_Proc_Macro">
      <bpmn:lane id="p00_Lane_Organizador" name="Organizador">
        <bpmn:flowNodeRef>p00_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_SP_RegistroOrg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_SP_Publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_Gw_Publicado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_Fin_Borrador</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p00_Lane_Asistente" name="Asistente">
        <bpmn:flowNodeRef>p00_SP_RegistroAsis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_SP_Compra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_Gw_Compra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_Fin_SinCompra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_Gw_Cancela</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_SP_Cancelar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_Gw_Reembolso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_Fin_Reembolsado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p00_Lane_Acceso" name="Personal de acceso">
        <bpmn:flowNodeRef>p00_Gw_UnirAcceso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_SP_Acceso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_Gw_Ingreso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_Fin_Ingreso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p00_Fin_Denegado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p00_Inicio" name="Organizador decide realizar un evento">
      <bpmn:outgoing>p00_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="p00_SP_RegistroOrg" name="Registro y autenticación del organizador">
      <bpmn:documentation>Detalle del subproceso en 01-registro-y-autenticacion.bpmn.</bpmn:documentation>
      <bpmn:incoming>p00_F01</bpmn:incoming>
      <bpmn:outgoing>p00_F02</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="p00_SP_Publicar" name="Publicar evento">
      <bpmn:documentation>Detalle del subproceso en 02-publicar-evento.bpmn.</bpmn:documentation>
      <bpmn:incoming>p00_F02</bpmn:incoming>
      <bpmn:outgoing>p00_F03</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="p00_Gw_Publicado" name="¿Evento publicado?" gatewayDirection="Diverging">
      <bpmn:incoming>p00_F03</bpmn:incoming>
      <bpmn:outgoing>p00_F04</bpmn:outgoing>
      <bpmn:outgoing>p00_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="p00_Fin_Borrador" name="Evento en borrador">
      <bpmn:incoming>p00_F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="p00_SP_RegistroAsis" name="Registro y autenticación del asistente">
      <bpmn:documentation>Detalle del subproceso en 01-registro-y-autenticacion.bpmn.</bpmn:documentation>
      <bpmn:incoming>p00_F05</bpmn:incoming>
      <bpmn:outgoing>p00_F06</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="p00_SP_Compra" name="Reserva y compra de entrada">
      <bpmn:documentation>Detalle del subproceso en 03-reserva-y-compra-de-entrada.bpmn.</bpmn:documentation>
      <bpmn:incoming>p00_F06</bpmn:incoming>
      <bpmn:outgoing>p00_F07</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="p00_Gw_Compra" name="¿Compra completada?" gatewayDirection="Diverging">
      <bpmn:incoming>p00_F07</bpmn:incoming>
      <bpmn:outgoing>p00_F08</bpmn:outgoing>
      <bpmn:outgoing>p00_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="p00_Fin_SinCompra" name="Compra no realizada">
      <bpmn:incoming>p00_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="p00_Gw_Cancela" name="¿Solicita cancelación?" gatewayDirection="Diverging">
      <bpmn:incoming>p00_F09</bpmn:incoming>
      <bpmn:outgoing>p00_F10</bpmn:outgoing>
      <bpmn:outgoing>p00_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="p00_SP_Cancelar" name="Cancelación y reembolso">
      <bpmn:documentation>Detalle del subproceso en 04-cancelacion-y-reembolso.bpmn.</bpmn:documentation>
      <bpmn:incoming>p00_F10</bpmn:incoming>
      <bpmn:outgoing>p00_F12</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="p00_Gw_Reembolso" name="¿Reembolso aprobado?" gatewayDirection="Diverging">
      <bpmn:incoming>p00_F12</bpmn:incoming>
      <bpmn:outgoing>p00_F13</bpmn:outgoing>
      <bpmn:outgoing>p00_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="p00_Fin_Reembolsado" name="Entrada cancelada y reembolsada">
      <bpmn:incoming>p00_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="p00_Gw_UnirAcceso" gatewayDirection="Converging">
      <bpmn:incoming>p00_F11</bpmn:incoming>
      <bpmn:incoming>p00_F14</bpmn:incoming>
      <bpmn:outgoing>p00_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="p00_SP_Acceso" name="Control de acceso (check-in)">
      <bpmn:documentation>Detalle del subproceso en 05-control-de-acceso-checkin.bpmn.</bpmn:documentation>
      <bpmn:incoming>p00_F15</bpmn:incoming>
      <bpmn:outgoing>p00_F16</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="p00_Gw_Ingreso" name="¿Ingreso permitido?" gatewayDirection="Diverging">
      <bpmn:incoming>p00_F16</bpmn:incoming>
      <bpmn:outgoing>p00_F17</bpmn:outgoing>
      <bpmn:outgoing>p00_F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="p00_Fin_Ingreso" name="Asistente dentro del evento">
      <bpmn:incoming>p00_F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="p00_Fin_Denegado" name="Ingreso denegado">
      <bpmn:incoming>p00_F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p00_F01" sourceRef="p00_Inicio" targetRef="p00_SP_RegistroOrg"/>
    <bpmn:sequenceFlow id="p00_F02" sourceRef="p00_SP_RegistroOrg" targetRef="p00_SP_Publicar"/>
    <bpmn:sequenceFlow id="p00_F03" sourceRef="p00_SP_Publicar" targetRef="p00_Gw_Publicado"/>
    <bpmn:sequenceFlow id="p00_F04" name="No" sourceRef="p00_Gw_Publicado" targetRef="p00_Fin_Borrador"/>
    <bpmn:sequenceFlow id="p00_F05" name="Sí" sourceRef="p00_Gw_Publicado" targetRef="p00_SP_RegistroAsis"/>
    <bpmn:sequenceFlow id="p00_F06" sourceRef="p00_SP_RegistroAsis" targetRef="p00_SP_Compra"/>
    <bpmn:sequenceFlow id="p00_F07" sourceRef="p00_SP_Compra" targetRef="p00_Gw_Compra"/>
    <bpmn:sequenceFlow id="p00_F08" name="No" sourceRef="p00_Gw_Compra" targetRef="p00_Fin_SinCompra"/>
    <bpmn:sequenceFlow id="p00_F09" name="Sí" sourceRef="p00_Gw_Compra" targetRef="p00_Gw_Cancela"/>
    <bpmn:sequenceFlow id="p00_F10" name="Sí" sourceRef="p00_Gw_Cancela" targetRef="p00_SP_Cancelar"/>
    <bpmn:sequenceFlow id="p00_F11" name="No" sourceRef="p00_Gw_Cancela" targetRef="p00_Gw_UnirAcceso"/>
    <bpmn:sequenceFlow id="p00_F12" sourceRef="p00_SP_Cancelar" targetRef="p00_Gw_Reembolso"/>
    <bpmn:sequenceFlow id="p00_F13" name="Sí" sourceRef="p00_Gw_Reembolso" targetRef="p00_Fin_Reembolsado"/>
    <bpmn:sequenceFlow id="p00_F14" name="No" sourceRef="p00_Gw_Reembolso" targetRef="p00_Gw_UnirAcceso"/>
    <bpmn:sequenceFlow id="p00_F15" sourceRef="p00_Gw_UnirAcceso" targetRef="p00_SP_Acceso"/>
    <bpmn:sequenceFlow id="p00_F16" sourceRef="p00_SP_Acceso" targetRef="p00_Gw_Ingreso"/>
    <bpmn:sequenceFlow id="p00_F17" name="Sí" sourceRef="p00_Gw_Ingreso" targetRef="p00_Fin_Ingreso"/>
    <bpmn:sequenceFlow id="p00_F18" name="No" sourceRef="p00_Gw_Ingreso" targetRef="p00_Fin_Denegado"/>
    <bpmn:textAnnotation id="p00_Nota_Plataforma">
      <bpmn:text>La Plataforma (sistema) interviene dentro de cada subproceso; el detalle está en los archivos 01 a 05.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="p00_Asoc_Nota_Plataforma" associationDirection="None" sourceRef="p00_Nota_Plataforma" targetRef="p00_SP_Publicar"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p00_Diagrama" name="Macroproceso de gestión de eventos">
    <bpmndi:BPMNPlane id="p00_Plano" bpmnElement="p00_Colaboracion">
      <bpmndi:BPMNShape id="p00_Pool_Pasarela_di" bpmnElement="p00_Pool_Pasarela" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="2082" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p00_Pool_Sistema_di" bpmnElement="p00_Pool_Sistema" isHorizontal="true">

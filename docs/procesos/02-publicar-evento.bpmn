      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_T_Entradas_di" bpmnElement="p02_T_Entradas">
        <dc:Bounds x="570" y="85" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_T_Validar_di" bpmnElement="p02_T_Validar">
        <dc:Bounds x="760" y="555" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_Gw_Valida_di" bpmnElement="p02_Gw_Valida">
        <dc:Bounds x="950" y="570" width="40" height="40"/>
        <bpmndi:BPMNLabel><dc:Bounds x="927" y="536" width="86" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_Gw_Division_di" bpmnElement="p02_Gw_Division">
        <dc:Bounds x="1050" y="570" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_T_Pagina_di" bpmnElement="p02_T_Pagina">
        <dc:Bounds x="1150" y="395" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_T_Inventario_di" bpmnElement="p02_T_Inventario">
        <dc:Bounds x="1150" y="555" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_T_Indexar_di" bpmnElement="p02_T_Indexar">
        <dc:Bounds x="1150" y="715" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_Gw_Union_di" bpmnElement="p02_Gw_Union">
        <dc:Bounds x="1340" y="570" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_T_VistaPrevia_di" bpmnElement="p02_T_VistaPrevia">
        <dc:Bounds x="1440" y="85" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_Gw_Confirma_di" bpmnElement="p02_Gw_Confirma">
        <dc:Bounds x="1630" y="100" width="40" height="40"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1607" y="66" width="86" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_T_Borrador_di" bpmnElement="p02_T_Borrador">
        <dc:Bounds x="1730" y="395" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_Fin_Borrador_di" bpmnElement="p02_Fin_Borrador">
        <dc:Bounds x="1967" y="412" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1944" y="454" width="82" height="42"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_T_Publicar_di" bpmnElement="p02_T_Publicar">
        <dc:Bounds x="1730" y="555" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_T_Notificar_di" bpmnElement="p02_T_Notificar">
        <dc:Bounds x="1920" y="555" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_Fin_Publicado_di" bpmnElement="p02_Fin_Publicado">
        <dc:Bounds x="2110" y="572" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="2087" y="614" width="82" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_Nota_Sesion_di" bpmnElement="p02_Nota_Sesion">
        <dc:Bounds x="150" y="245" width="170" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="p02_F01_di" bpmnElement="p02_F01">
        <di:waypoint x="253" y="120"/>
        <di:waypoint x="380" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p02_F02_di" bpmnElement="p02_F02">
        <di:waypoint x="510" y="120"/>
        <di:waypoint x="570" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p02_F03_di" bpmnElement="p02_F03">
        <di:waypoint x="700" y="120"/>
        <di:waypoint x="730" y="120"/>
        <di:waypoint x="730" y="590"/>
        <di:waypoint x="760" y="590"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p02_F04_di" bpmnElement="p02_F04">
        <di:waypoint x="890" y="590"/>
        <di:waypoint x="950" y="590"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p02_F05_di" bpmnElement="p02_F05">
        <di:waypoint x="990" y="590"/>

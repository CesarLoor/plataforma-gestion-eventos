        <di:waypoint x="1070" y="570"/>
        <di:waypoint x="1070" y="430"/>
        <di:waypoint x="1150" y="430"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p02_F08_di" bpmnElement="p02_F08">
        <di:waypoint x="1090" y="590"/>
        <di:waypoint x="1150" y="590"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p02_F09_di" bpmnElement="p02_F09">
        <di:waypoint x="1070" y="610"/>
        <di:waypoint x="1070" y="750"/>
        <di:waypoint x="1150" y="750"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p02_F10_di" bpmnElement="p02_F10">
        <di:waypoint x="1280" y="430"/>
        <di:waypoint x="1360" y="430"/>
        <di:waypoint x="1360" y="570"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p02_F11_di" bpmnElement="p02_F11">
        <di:waypoint x="1280" y="590"/>
        <di:waypoint x="1340" y="590"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p02_F12_di" bpmnElement="p02_F12">
        <di:waypoint x="1280" y="750"/>
        <di:waypoint x="1360" y="750"/>
        <di:waypoint x="1360" y="610"/>
      </bpmndi:BPMNEdge>

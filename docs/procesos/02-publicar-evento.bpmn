<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="p02_Definiciones" targetNamespace="http://gestion-eventos.local/bpmn/p02">
  <bpmn:collaboration id="p02_Colaboracion" name="Publicar evento">
    <bpmn:participant id="p02_Pool_Sistema" name="Sistema de gestión de eventos" processRef="p02_Proc_PublicarEvento"/>
  </bpmn:collaboration>
  <bpmn:process id="p02_Proc_PublicarEvento" name="Publicar evento" isExecutable="false" processType="None">
    <bpmn:laneSet id="p02_LaneSet_Proc_PublicarEvento">
      <bpmn:lane id="p02_Lane_Organizador" name="Organizador">
        <bpmn:flowNodeRef>p02_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_T_DatosEvento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_T_Entradas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_T_VistaPrevia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_Gw_Confirma</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p02_Lane_Plataforma" name="Plataforma (sistema)">
        <bpmn:flowNodeRef>p02_T_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_Gw_Valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_Gw_Division</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_T_Pagina</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_T_Inventario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_T_Indexar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_Gw_Union</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_T_Borrador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_Fin_Borrador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_T_Publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_T_Notificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p02_Fin_Publicado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p02_Inicio" name="Organizador inicia la creación de un evento">
      <bpmn:outgoing>p02_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p02_T_DatosEvento" name="Registrar datos generales del evento">
      <bpmn:documentation>Nombre, descripción, fecha, hora, lugar y categoría.</bpmn:documentation>
      <bpmn:incoming>p02_F01</bpmn:incoming>
      <bpmn:incoming>p02_F06</bpmn:incoming>
      <bpmn:outgoing>p02_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p02_T_Entradas" name="Configurar tipos de entrada, precios y aforo">
      <bpmn:incoming>p02_F02</bpmn:incoming>
      <bpmn:outgoing>p02_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p02_T_Validar" name="Validar información del evento">
      <bpmn:documentation>ms-eventos: fechas futuras, aforo &gt; 0, precios válidos, lugar disponible.</bpmn:documentation>
      <bpmn:incoming>p02_F03</bpmn:incoming>
      <bpmn:outgoing>p02_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p02_Gw_Valida" name="¿Información válida?" gatewayDirection="Diverging">
      <bpmn:incoming>p02_F04</bpmn:incoming>
      <bpmn:outgoing>p02_F05</bpmn:outgoing>
      <bpmn:outgoing>p02_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="p02_Gw_Division" gatewayDirection="Diverging">
      <bpmn:incoming>p02_F05</bpmn:incoming>
      <bpmn:outgoing>p02_F07</bpmn:outgoing>
      <bpmn:outgoing>p02_F08</bpmn:outgoing>
      <bpmn:outgoing>p02_F09</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="p02_T_Pagina" name="Generar página pública del evento">
      <bpmn:documentation>ms-eventos</bpmn:documentation>
      <bpmn:incoming>p02_F07</bpmn:incoming>
      <bpmn:outgoing>p02_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p02_T_Inventario" name="Crear inventario de cupos">
      <bpmn:documentation>ms-reservas: crea el inventario por tipo de entrada.</bpmn:documentation>
      <bpmn:incoming>p02_F08</bpmn:incoming>
      <bpmn:outgoing>p02_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p02_T_Indexar" name="Indexar evento en el catálogo de búsqueda">
      <bpmn:documentation>ms-catalogo</bpmn:documentation>
      <bpmn:incoming>p02_F09</bpmn:incoming>
      <bpmn:outgoing>p02_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="p02_Gw_Union" gatewayDirection="Converging">
      <bpmn:incoming>p02_F10</bpmn:incoming>
      <bpmn:incoming>p02_F11</bpmn:incoming>
      <bpmn:incoming>p02_F12</bpmn:incoming>
      <bpmn:outgoing>p02_F13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="p02_T_VistaPrevia" name="Revisar vista previa del evento">
      <bpmn:incoming>p02_F13</bpmn:incoming>
      <bpmn:outgoing>p02_F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p02_Gw_Confirma" name="¿Confirma la publicación?" gatewayDirection="Diverging">
      <bpmn:incoming>p02_F14</bpmn:incoming>
      <bpmn:outgoing>p02_F15</bpmn:outgoing>
      <bpmn:outgoing>p02_F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p02_T_Borrador" name="Guardar evento como borrador">
      <bpmn:incoming>p02_F16</bpmn:incoming>
      <bpmn:outgoing>p02_F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p02_Fin_Borrador" name="Evento guardado como borrador">
      <bpmn:incoming>p02_F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="p02_T_Publicar" name="Publicar evento">
      <bpmn:documentation>ms-eventos: cambia el estado a PUBLICADO y habilita la venta.</bpmn:documentation>
      <bpmn:incoming>p02_F15</bpmn:incoming>
      <bpmn:outgoing>p02_F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p02_T_Notificar" name="Notificar a los asistentes suscritos">
      <bpmn:documentation>ms-notificaciones</bpmn:documentation>
      <bpmn:incoming>p02_F18</bpmn:incoming>
      <bpmn:outgoing>p02_F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p02_Fin_Publicado" name="Evento publicado">
      <bpmn:incoming>p02_F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p02_F01" sourceRef="p02_Inicio" targetRef="p02_T_DatosEvento"/>
    <bpmn:sequenceFlow id="p02_F02" sourceRef="p02_T_DatosEvento" targetRef="p02_T_Entradas"/>
    <bpmn:sequenceFlow id="p02_F03" sourceRef="p02_T_Entradas" targetRef="p02_T_Validar"/>
    <bpmn:sequenceFlow id="p02_F04" sourceRef="p02_T_Validar" targetRef="p02_Gw_Valida"/>
    <bpmn:sequenceFlow id="p02_F05" name="Sí" sourceRef="p02_Gw_Valida" targetRef="p02_Gw_Division"/>
    <bpmn:sequenceFlow id="p02_F06" name="No, corregir" sourceRef="p02_Gw_Valida" targetRef="p02_T_DatosEvento"/>
    <bpmn:sequenceFlow id="p02_F07" sourceRef="p02_Gw_Division" targetRef="p02_T_Pagina"/>
    <bpmn:sequenceFlow id="p02_F08" sourceRef="p02_Gw_Division" targetRef="p02_T_Inventario"/>
    <bpmn:sequenceFlow id="p02_F09" sourceRef="p02_Gw_Division" targetRef="p02_T_Indexar"/>
    <bpmn:sequenceFlow id="p02_F10" sourceRef="p02_T_Pagina" targetRef="p02_Gw_Union"/>
    <bpmn:sequenceFlow id="p02_F11" sourceRef="p02_T_Inventario" targetRef="p02_Gw_Union"/>
    <bpmn:sequenceFlow id="p02_F12" sourceRef="p02_T_Indexar" targetRef="p02_Gw_Union"/>
    <bpmn:sequenceFlow id="p02_F13" sourceRef="p02_Gw_Union" targetRef="p02_T_VistaPrevia"/>
    <bpmn:sequenceFlow id="p02_F14" sourceRef="p02_T_VistaPrevia" targetRef="p02_Gw_Confirma"/>
    <bpmn:sequenceFlow id="p02_F15" name="Sí" sourceRef="p02_Gw_Confirma" targetRef="p02_T_Publicar"/>
    <bpmn:sequenceFlow id="p02_F16" name="No, guardar borrador" sourceRef="p02_Gw_Confirma" targetRef="p02_T_Borrador"/>
    <bpmn:sequenceFlow id="p02_F17" sourceRef="p02_T_Borrador" targetRef="p02_Fin_Borrador"/>
    <bpmn:sequenceFlow id="p02_F18" sourceRef="p02_T_Publicar" targetRef="p02_T_Notificar"/>
    <bpmn:sequenceFlow id="p02_F19" sourceRef="p02_T_Notificar" targetRef="p02_Fin_Publicado"/>
    <bpmn:textAnnotation id="p02_Nota_Sesion">
      <bpmn:text>Requiere sesión de organizador autenticada (proceso 01).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="p02_Asoc_Nota_Sesion" associationDirection="None" sourceRef="p02_Nota_Sesion" targetRef="p02_Inicio"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p02_Diagrama" name="Publicar evento">
    <bpmndi:BPMNPlane id="p02_Plano" bpmnElement="p02_Colaboracion">
      <bpmndi:BPMNShape id="p02_Pool_Sistema_di" bpmnElement="p02_Pool_Sistema" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="2166" height="790"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_Lane_Organizador_di" bpmnElement="p02_Lane_Organizador" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="2136" height="310"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_Lane_Plataforma_di" bpmnElement="p02_Lane_Plataforma" isHorizontal="true">
        <dc:Bounds x="70" y="350" width="2136" height="480"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_Inicio_di" bpmnElement="p02_Inicio">
        <dc:Bounds x="217" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="194" y="40" width="82" height="56"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p02_T_DatosEvento_di" bpmnElement="p02_T_DatosEvento">

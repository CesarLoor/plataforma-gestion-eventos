# Copia generada por `npm run env` (no edites .env a mano salvo DOMAIN/PUBLIC_URL).
# Nunca subas .env al repositorio: tiene contraseñas y claves privadas.

# Dominio público. Local: localhost. EC2: <ip-con-guiones>.sslip.io (certificado de Let's Encrypt)
DOMAIN=localhost
PUBLIC_URL=https://localhost

# PostgreSQL: superusuario y una contraseña por servicio (cada servicio solo accede a su base)
POSTGRES_PASSWORD=
DB_PASS_AUTH=
DB_PASS_CATALOG=
DB_PASS_INVENTORY=
DB_PASS_ORDERS=
DB_PASS_TICKETS=
DB_PASS_CHECKIN=
DB_PASS_NOTIFICATIONS=
DB_PASS_REPORTS=

# Claves Ed25519 en PEM codificado en base64: JWT de usuarios (auth) y QR de tickets (tickets)
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=
TICKETS_PRIVATE_KEY=
TICKETS_PUBLIC_KEY=

# Secretos compartidos: llamadas entre servicios y pasarela simulada
INTERNAL_JWT_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_KEY=

# Contraseña de los usuarios semilla (admin, organizador, acceso, asistente)
SEED_PASSWORD=

# Reglas de negocio
MAX_INTENTOS=3
RESERVA_MINUTOS=10
